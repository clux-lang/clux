/* std/mem.cx — 分配器与 Arena（见 std/design/01-mem.md）
 *
 * 模式（A）：`Allocator` 是**基类**，用显式函数指针字段实现分派；
 * `self` 就是上下文，不再单独携带 ctx。具体分配器继承 `Allocator`，
 * 在实现里 `self as *具体类型` 取回自身状态，构造时填好两个函数指针。
 */

extern lib libc from "*";
extern cfunc libc::malloc(n: usize): opaque;
extern cfunc libc::free(p: opaque): void;

/* ------------------------------------------------------------------ */
/* Allocator（基类）                                                    */
/* ------------------------------------------------------------------ */

export struct Allocator {
    _alloc: func(*Allocator, usize, usize) -> ?*u8;
    _free: func(*Allocator, *u8) -> void;

    /* 分配 size 字节、按 align 对齐；size == 0 或失败返回 nil。 */
    func alloc(self: *Allocator, size: usize, align: usize): ?*u8 {
        if (size == 0usize) {
            return .?*u8{ nil };
        }
        return self._alloc(self, size, align);
    }

    /* 释放；ptr 必须来自同一分配器。 */
    func free(self: *Allocator, ptr: *u8): void {
        self._free(self, ptr);
    }
}

/* ------------------------------------------------------------------ */
/* 工具                                                                */
/* ------------------------------------------------------------------ */

export func align_up(n: usize, align: usize): usize {
    if (align <= 1usize) {
        return n;
    }
    var rem: usize = n % align;
    if (rem == 0usize) {
        return n;
    }
    return n + (align - rem);
}

/* ------------------------------------------------------------------ */
/* 堆分配器（libc malloc/free 的封装）                                  */
/* ------------------------------------------------------------------ */

export struct HeapAllocator {
    ...Allocator;

    func do_alloc(self: *Allocator, size: usize, align: usize): ?*u8 {
        var raw: opaque = libc::malloc(size);
        if (raw as usize == 0usize) {
            return .?*u8{ nil };
        }
        return raw as *u8;
    }

    func do_free(self: *Allocator, ptr: *u8): void {
        libc::free(ptr as opaque);
    }

    func new(): HeapAllocator {
        return .HeapAllocator{
            ._alloc = HeapAllocator::do_alloc,
            ._free = HeapAllocator::do_free
        };
    }
}

/* 禁用分配：任何分配都失败（测试"不该分配"的场景）。 */
export struct NullAllocator {
    ...Allocator;

    func do_alloc(self: *Allocator, size: usize, align: usize): ?*u8 {
        return .?*u8{ nil };
    }

    func do_free(self: *Allocator, ptr: *u8): void {}

    func new(): NullAllocator {
        return .NullAllocator{
            ._alloc = NullAllocator::do_alloc,
            ._free = NullAllocator::do_free
        };
    }
}

/* ------------------------------------------------------------------ */
/* Arena：向 backing 按块申请，整块释放                                  */
/* ------------------------------------------------------------------ */

struct ArenaChunk {
    next: ?*ArenaChunk;
    payload: *u8;
    size: usize;
}

export struct Arena {
    ...Allocator;
    backing: *Allocator;
    chunk: usize;
    head: ?*ArenaChunk;
    cur: ?*u8;
    cur_size: usize;
    used: usize;

    /* `backing` 必须活得比 arena 久（通常是一个长生命周期的分配器）。 */
    func new(backing: *Allocator, chunk: usize): Arena {
        return .Arena{
            ._alloc = Arena::do_alloc,
            ._free = Arena::do_free,
            .backing = backing,
            .chunk = chunk,
            .head = nil,
            .cur = nil,
            .cur_size = 0usize,
            .used = 0usize
        };
    }

    func new_chunk(self: *Arena, need: usize): bool {
        var want: usize = self.chunk;
        if (want < need) {
            want = need;
        }
        var hp: ?*u8 = self.backing.alloc(sizeof(ArenaChunk), alignof(ArenaChunk));
        if (hp == nil) {
            return false;
        }
        var bp: ?*u8 = self.backing.alloc(want, 16usize);
        if (bp == nil) {
            self.backing.free(hp.!);
            return false;
        }
        var ch: *ArenaChunk = hp.! as *ArenaChunk;
        ch.payload = bp.!;
        ch.size = want;
        ch.next = self.head;
        self.head = ch;
        self.cur = bp;
        self.cur_size = want;
        self.used = 0usize;
        return true;
    }

    func do_alloc(self: *Allocator, size: usize, align: usize): ?*u8 {
        var a: *Arena = self as *Arena;
        if (a.cur == nil) {
            if (!a.new_chunk(align_up(size, 16usize))) {
                return .?*u8{ nil };
            }
        }
        var off: usize = align_up(a.used, align);
        if (off + size > a.cur_size) {
            if (!a.new_chunk(align_up(size, 16usize))) {
                return .?*u8{ nil };
            }
            off = 0usize;
        }
        a.used = off + size;
        var base: *u8 = a.cur.!;
        var view: []u8 = make(base, a.cur_size);
        return view[off].&;
    }

    func do_free(self: *Allocator, ptr: *u8): void {
    /* 整块释放：单次 free 是 no-op。 */
}

    func reset(self: *Arena): void {
        var c: ?*ArenaChunk = self.head;
        while (c != nil) {
            var nxt: ?*ArenaChunk = c.!.next;
            self.backing.free(c.!.payload);
            self.backing.free(c.! as *u8);
            c = nxt;
        }
        self.head = nil;
        self.cur = nil;
        self.cur_size = 0usize;
        self.used = 0usize;
    }

    func __dispose__(self: *Arena): void {
        self.reset();
    }
}

/* ------------------------------------------------------------------ */
/* 测试                                                                */
/* ------------------------------------------------------------------ */

test "mem.heapAllocFree" {
    var h: HeapAllocator = HeapAllocator::new();
    var p: ?*u8 = h.alloc(32usize, 8usize);
    assert(p != nil);
    var b: []u8 = make(p.!, 32usize);
    b[0] = 7 as u8;
    assert(b[0] == 7 as u8);
    h.free(p.!);
}

test "mem.zeroSize" {
    var h: HeapAllocator = HeapAllocator::new();
    var p: ?*u8 = h.alloc(0usize, 8usize);
    assert(p == nil);
}

test "mem.nullAllocatorFails" {
    var n: NullAllocator = NullAllocator::new();
    var p: ?*u8 = n.alloc(16usize, 8usize);
    assert(p == nil);
}

test "mem.alignUp" {
    assert(align_up(0usize, 8usize) == 0usize);
    assert(align_up(1usize, 8usize) == 8usize);
    assert(align_up(8usize, 8usize) == 8usize);
    assert(align_up(9usize, 8usize) == 16usize);
    assert(align_up(5usize, 1usize) == 5usize);
}

test "mem.arenaBump" {
    var h: HeapAllocator = HeapAllocator::new();
    var ar: Arena = Arena::new(h.& as *Allocator, 256usize);

    var p1: ?*u8 = ar.alloc(16usize, 8usize);
    var p2: ?*u8 = ar.alloc(16usize, 8usize);
    assert(p1 != nil);
    assert(p2 != nil);
    assert(p1.! != p2.!);

    var b1: []u8 = make(p1.!, 16usize);
    var b2: []u8 = make(p2.!, 16usize);
    b1[0] = 1 as u8;
    b2[0] = 2 as u8;
    assert(b1[0] == 1 as u8);
    assert(b2[0] == 2 as u8);

    ar.reset();
    var p3: ?*u8 = ar.alloc(16usize, 8usize);
    assert(p3 != nil);
    ar.__dispose__();
}

test "mem.arenaGrow" {
    var h: HeapAllocator = HeapAllocator::new();
    var ar: Arena = Arena::new(h.& as *Allocator, 64usize);
    var i: usize = 0usize;
    while (i < 40usize) {
        var p: ?*u8 = ar.alloc(32usize, 8usize);
        assert(p != nil);
        var bv: []u8 = make(p.!, 32usize);
        bv[0] = i as u8;
        assert(bv[0] == i as u8);
        i = i + 1usize;
    }
    ar.__dispose__();
}
