// probe4: fatal 复合类型返回值（函数内 move 出去，调用方接管）
// 注：`make` 是 clux 关键字（数组/切片构造宏），函数不能叫 make。
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Box {
    p: own *i32;
    n: i32;
}

func mkbox(n: i32): fatal Box {
    var b: Box = .Box{ .p = new i32{n}, .n = n };
    return move(b);
}

func main(): i32 {
    var a: Box = mkbox(7);
    if (a.n != 7) { return 1; }
    if (a.p.* != 7) { return 2; }
    libc::printf("fatal return: ok\n");
    return 0;
}
