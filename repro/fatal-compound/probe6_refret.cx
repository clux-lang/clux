// probe6: 返回"含 ref 字段的结构体"必须有作用域标注（§5 强制规则）
//   - 已标注 '<p> → 放行（本文件）
//   - 未标注 → 编译错误（probe6b_refret.rejected.cx）
// 修复前：只查顶层 `ref *T` 的标注，含 ref 字段的复合返回类型静默放行
//         → 调用方拿到借用被调用方局部的悬垂指针（指针逃逸）。
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Holder {
    r: ref *i32;
    n: i32;
}

// 借自参数 p
func annot(p: ref *i32): '<p> Holder {
    return .Holder{ .r = p, .n = 2 };
}

// 嵌套：数组元素含 ref 的复合类型，同样必须标注
func annot_arr(p: ref *i32): '<p> [1]Holder {
    return .[1]Holder{ .Holder{ .r = p, .n = 3 } };
}

func main(): i32 {
    var x: i32 = 41;
    // 调用方侧：含 ref 字段的变量同样必须标注（§5 对声明与返回一视同仁）；
    // 锚点是本作用域的 x，故用 '<x>。
    var h: '<x> Holder = annot(x.&);
    if (h.n != 2) { return 1; }
    if (h.r.* != 41) { return 2; }
    var arr: '<x> [1]Holder = annot_arr(x.&);
    if (arr[0].r.* != 41) { return 3; }
    libc::printf("ref-field return annotation: ok\n");
    return 0;
}
