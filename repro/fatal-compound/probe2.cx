// probe2: move(struct) / clone(struct) 在函数内部（不跨边界）是否工作
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Box {
    p: own *i32;
    n: i32;
}

func main(): i32 {
    var a: Box = .Box{ .p = new i32{7}, .n = 7 };
    var b: Box = clone(a);
    if (b.n != 7 || a.n != 7) { return 1; }
    var c: Box = move(a);
    if (c.n != 7) { return 2; }
    return 0;
}
