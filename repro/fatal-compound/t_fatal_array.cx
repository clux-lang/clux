extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Inner { p: own *i32; }

func sum(a: fatal [2]Inner): i32 {
    var owned: [2]Inner = move(a);
    return owned[0].p.* + owned[1].p.*;
}

func main(): i32 {
    var arr: [2]Inner = .[2]Inner{ .Inner{ .p = new i32{3} },
                                   .Inner{ .p = new i32{4} } };
    var r: i32 = sum(move(arr));
    if (r != 7) { return 1; }
    libc::printf("fatal array param: ok\n");
    return 0;
}
