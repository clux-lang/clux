extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Inner { p: own *i32; }
struct Box { p: own *i32; n: i32; }

// A) fatal Box 参数原样 return（转发）
func idbox(b: fatal Box): fatal Box {
    return b;
}

// B) 局部 move 数组
func main(): i32 {
    var a: Box = .Box{ .p = new i32{5}, .n = 6 };
    var c: Box = idbox(move(a));
    if (c.p.* != 5 || c.n != 6) { return 1; }
    libc::printf("A ok\n");

    var arr: [2]Inner = .[2]Inner{ .Inner{ .p = new i32{3} },
                                   .Inner{ .p = new i32{4} } };
    var arr2: [2]Inner = move(arr);
    if (arr2[0].p.* != 3 || arr2[1].p.* != 4) { return 2; }
    libc::printf("B ok\n");
    return 0;
}
