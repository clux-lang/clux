// probe6b: **反例** —— 返回含 ref 字段的结构体但**不标注作用域** → 必须报错
// 修复前：静默编译通过（ref 逃逸：调用方拿到借用被调用方局部的悬垂指针）。
// 诊断：function 'unannotated' returns a value of type 'Holder' which contains
//       ref pointers and must declare their scope (annotate the return type,
//       e.g. '<p> Holder)
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Holder {
    r: ref *i32;
    n: i32;
}

func unannotated(p: ref *i32): Holder {
    return .Holder{ .r = p, .n = 1 };
}

func main(): i32 {
    return 0;
}
