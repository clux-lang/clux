// 嵌套 struct / 含 own 的元组 / 含 own 元素的数组
struct Inner { p: own *i32; }
struct Outer { inner: Inner; n: i32; }
func main(): i32 {
    var o = .Outer{ .inner = .Inner{ .p = new i32{5} }, .n = 2 };
    if (o.inner.p.* != 5) { return 1; }
    var t = .<own *i32, i32>{ new i32{8}, 9 };
    if (t[0].* != 8 || t[1] != 9) { return 2; }
    var arr = .[2]Inner{ .Inner{ .p = new i32{10} }, .Inner{ .p = new i32{11} } };
    if (arr[0].p.* != 10 || arr[1].p.* != 11) { return 3; }
    return 0;
}