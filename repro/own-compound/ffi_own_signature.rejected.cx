// ffi_own_signature.rejected.cx: **反例** —— extern cfunc/var 签名不得含 own 资源
//
// "签名即约束"：含 own 资源的类型（顶层 own 指针，或递归含 own 字段的复合类型）
// 出现在 C ABI 签名里就是**声明处非法**——C 只看到裸指针字段，会拿到一个仍由
// clux 拥有的堆块（谁来 free？），语义无法表达。
//
// 期望诊断（四条）：
//   extern cfunc libc::f: parameter 'p': the type contains owned pointers …
//   extern cfunc libc::g: parameter 'b': the type contains owned pointers …
//   extern cfunc libc::h: return type: the type contains owned pointers …
//   extern var libc::v: the type contains owned pointers …
//
// 合法形态见 ffi_own_ok.cx（ref/fatal 指针 + 平凡 struct 跨 C ABI 照旧）。
extern lib "*" as libc;

extern cfunc libc::f(p: own *i32): i32;   // 顶层 own 指针参数
extern cfunc libc::g(b: Box): i32;        // 含 own 字段的 struct 参数
extern cfunc libc::h(): Box;              // 含 own 字段的 struct 返回
extern var libc::v: own *i32;             // own 指针 extern var

struct Box { p: own *i32; n: i32 }

func main(): i32 { return 0; }
