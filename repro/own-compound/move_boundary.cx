// move_boundary.cx: move 边界的**正向**情形（用户 2026-10 明确的两条规则）
//
// 规则 1 正向：结构体只能**整体** move。
// 规则 2 正向：闭包本体（TYPE_KIND_FUNC）与闭包捕获都不可 move；闭包内可以
//             clone / 借用；闭包体内**自定义**的局部变量照常可 move。
struct Box { p: own *i32; n: i32; }

// 整体 move 结构体：合法
func whole_struct_move(): i32 {
    var b: Box = .Box{ .p = new i32{7}, .n = 1 };
    var c: Box = move(b);
    return c.p.*;
}

// 字段 clone：合法（不改变源的绑定状态）
func field_clone(): i32 {
    var b: Box = .Box{ .p = new i32{8}, .n = 1 };
    var q: own *i32 = clone(b.p);
    var r: i32 = q.* + b.p.*;
    return r;                       // 16
}

// 闭包捕获后 clone / 借用读取：合法
func capture_clone_and_borrow(): i32 {
    var b: Box = .Box{ .p = new i32{9}, .n = 3 };
    var f = func |(c: Box = move(b))| get(): i32 {
        var d: Box = clone(c);      // clone 捕获槽：合法
        return d.p.* + c.n;         // 借用读取捕获槽：合法
    };
    return f();                     // 12
}

// 闭包体内自定义局部变量 move：合法（TDZ 随该次调用消亡）
func local_inside_closure(): i32 {
    var f = func |(seed: i32 = 0)| get(): i32 {
        var a: own *i32 = new i32{5};
        var b: own *i32 = move(a);  // 局部（非捕获）：可 move
        return b.* + seed;
    };
    return f();
}

func main(): i32 {
    if (whole_struct_move() != 7) { return 1; }
    if (field_clone() != 16) { return 2; }
    if (capture_clone_and_borrow() != 12) { return 3; }
    if (local_inside_closure() != 5) { return 4; }
    return 0;
}
