// ref_agg_assign_escape.rejected.cx: **反例** —— 赋值使作用域承诺不成立（§5.1）
//
// 标注 `'<A>` 是"本变量持有的借用**至少活到 A**"的承诺。把只借到**更短寿命**
// 的值赋给它，承诺就不成立（变量活得比它借的东西久 → 悬垂）：
//
//   error: cannot assign into variable 'g': its scope annotation '<*>' is not
//          within the assigned value's borrow scope
//
// 三种写法都要拒绝：构造式内联 / 变量直接赋 / 变量经 move。
struct H { r: ref *i32; n: i32; }
var gx: i32 = 9;

// 变体 1：构造式内联 —— 承诺活到全局，实际只借到参数 p（p 比全局短）
func v1_inline(p: ref *i32): i32 {
    var g: '<*> H = .H{ .r = gx.&, .n = 1 };
    g = .H{ .r = p, .n = 2 };          // ❌ 承诺活到全局，实际只借到 p
    return g.n;
}

func main(): i32 { var x: i32 = 7; return v1_inline(x.&); }
