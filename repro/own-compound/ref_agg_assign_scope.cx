// ref_agg_assign_scope.cx: 含 ref 聚合类型的**赋值作用域检查**（§5 / §5.1）
//
// 声明侧只保证每个含 ref 的变量**有一个承诺**；赋值侧还要保证**承诺成立**。
//
// **语义（方向极易写反）**：标注 `'<A>` 不是"变量活到 A"，而是"本变量持有的借用
// **至少活到 A**"——对**被借对象**存活期的承诺。所以把值赋给 `g: '<A>` 要求
//
//        借源作用域 ⊇ A        等价于 within(A, 借源作用域)
//
// `'<*>` 是**最强**承诺（"我借的东西活到程序结束"），不是最弱。
//
// 本文件只放**通过**的情形；拒绝的见
// repro/own-compound/ref_agg_assign_escape.rejected.cx
struct H { r: ref *i32; n: i32; }

var gx: i32 = 9;   // 全局：比函数参数久

// ---- 通过 1：同锚点（承诺活到 p，借源也正是 p）----
func same_anchor(p: ref *i32): i32 {
    var g: '<p> H = .H{ .r = p, .n = 1 };
    g = .H{ .r = p, .n = 2 };
    return g.n;
}

// ---- 通过 2：承诺比借源**短**（承诺活到 p，实际借自更久的全局）----
func shorter_promise(p: ref *i32): i32 {
    var g: '<p> H = .H{ .r = p, .n = 1 };
    g = .H{ .r = gx.&, .n = 2 };
    return g.n;                                  // 2
}

// ---- 通过 3：源是变量，继承其借源集合（h 借自全局，承诺活到 p）----
func inherit_provenance(p: ref *i32): i32 {
    var g: '<p> H = .H{ .r = p, .n = 1 };
    var h: '<*> H = .H{ .r = gx.&, .n = 2 };
    g = move(h);
    return g.n;                                  // 2
}

func main(): i32 {
    var x: i32 = 7;
    if (same_anchor(x.&) != 2) { return 1; }
    if (shorter_promise(x.&) != 2) { return 2; }
    if (inherit_provenance(x.&) != 2) { return 3; }
    return 0;
}
