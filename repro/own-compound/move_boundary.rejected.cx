// move_boundary.rejected.cx: move 边界的**反例**（用户 2026-10 明确的两条规则）
//
// 规则 1：结构体**字段不可 move**（字段没有局部 TDZ，TDZ 是符号级的），
//         只能整体 move。标量字段同样不可 —— `var a = move(p.x)` 非法。
// 规则 2：**闭包本体与闭包捕获都不可 move**（闭包是携带捕获状态的结构体语法糖，
//         且不存在"闭包"这个整体变量；捕获槽由所有调用共享，TDZ 不可恢复）。
//
// 期望诊断：
//   cannot move a struct/aggregate field or element …
//   cannot move closure 'f': a closure is a struct carrying its capture state …
//   cannot move closure capture 'q': the capture slot is shared …
struct P { x: i32; y: i32; }
struct Box { p: own *i32; n: i32; }

// 规则 1：**标量**字段 move（用户点名 `var a = move(b.c)` 非法）
func v1_scalar_field_move(): i32 {
    var p: P = .P{ .x = 1, .y = 2 };
    var a: i32 = move(p.x);
    return a;
}

// 规则 1：own 字段 move
func v2_own_field_move(): i32 {
    var b: Box = .Box{ .p = new i32{7}, .n = 1 };
    var q: own *i32 = move(b.p);
    return q.*;
}

// 规则 2：闭包本体 move
func v3_closure_move(): i32 {
    var p: own *i32 = new i32{7};
    var f = func |(q: own *i32 = move(p))| get(): i32 { return q.*; };
    var g = move(f);
    return g();
}

// 规则 2：闭包捕获 move
func v4_capture_move(): i32 {
    var p: own *i32 = new i32{7};
    var f = func |(q: own *i32 = move(p))| get(): i32 {
        var r: own *i32 = move(q);
        return r.*;
    };
    return f();
}

func main(): i32 { return v1_scalar_field_move() + v2_own_field_move() + v3_closure_move() + v4_capture_move(); }
