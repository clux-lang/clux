// gap5: 参数位含 ref 字段 → 必须标注作用域
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Holder { r: ref *i32; n: i32; }

// 未标注：目标要求报错
func unannotated(h: Holder, v: i32): i32 { return h.r.* + v; }

// 已标注：放行
func annotated(h: '<p> Holder, p: ref *i32): i32 { return h.r.* + p.*; }

func main(): i32 { return 0; }
