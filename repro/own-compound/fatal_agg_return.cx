// fatal_agg_return.cx: **正例** —— fatal 聚合类型（array / union / tuple）跨函数边界返回
//
// 返回值路径上有**两处**会尝试把运行期 base 值 cast 到声明的 fatal 类型：
//   第 6 步（safe_cast 到声明返回类型）——**方向非法**（各族 implicit_cast 只认
//     fatal → base 的接管）。array/union 会直接失败：
//       run: array: implicit cast only within layout-compatible array/tuple
//   第 7 步（fatal 返回值的转移 + 重贴标签）——正解。
// 修法：声明返回类型 fatal 且带资源时，第 6 步让开，交给第 7 步
// （value_move + value_relabel_into）。见 docs/m3-design.md §7.5。
struct I { p: own *i32; }
union U { p: own *i32; n: i32 }

func mk_arr(): fatal [2]I {
    return move(.[2]I{ .I{ .p = new i32{7} }, .I{ .p = new i32{8} } });
}
func mk_uni(): fatal U { return move(.U{ .p = new i32{9} }); }
func mk_tup(): fatal <own *i32, i32> {
    return move(.<own *i32, i32>{ new i32{10}, 11 });
}
func fwd(x: fatal [2]I): fatal [2]I { return x; }

func main(): i32 {
    var a: [2]I = mk_arr();
    if (a[0].p.* != 7 || a[1].p.* != 8) { return 1; }

    var u: U = mk_uni();
    if (u.p.* != 9) { return 2; }

    var t: <own *i32, i32> = mk_tup();
    if (t[0].* != 10 || t[1] != 11) { return 3; }

    var f: [2]I = fwd(.[2]I{ .I{ .p = new i32{7} }, .I{ .p = new i32{8} } });
    if (f[0].p.* != 7 || f[1].p.* != 8) { return 4; }

    return 0;
}
