// gap3: 构造表达式产出 fatal T 之后，嵌套构造/字段位/管道是否还能用
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Inner { p: own *i32; }
struct Outer { inner: Inner; n: i32; }

func main(): i32 {
    // 外层构造的字段用内层构造初始化
    var o: Outer = .Outer{ .inner = .Inner{ .p = new i32{5} }, .n = 1 };
    if (o.inner.p.* != 5) { return 1; }
    return 0;
}
