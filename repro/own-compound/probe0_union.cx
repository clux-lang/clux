// probe0_union.cx: union 含 own payload —— 五项规则同样适用
//   回归：op_construct 的 union 分支原先 memcpy payload 后**没有清空源**，payload
//   临时值在作用域退出时先释放内嵌堆块，union 成员随后再释放同一个块 →
//   double-free（实测 access violation 0xC0000005）。
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

union U { p: own *i32; n: i32 }

// 参数含 own → 只能 fatal U
func take(u: fatal U): i32 {
    var owned: U = move(u);
    return owned.p.*;
}

func main(): i32 {
    var a: U = .U{ .p = new i32{5} };     // 构造产 fatal U → own 变量接管
    if (a.p.* != 5) { return 1; }

    var b: U = move(a);                   // 转移
    if (b.p.* != 5) { return 2; }

    var c: U = .U{ .p = new i32{6} };
    var d: U = clone(c);                  // 深拷贝：两者独立
    if (d.p.* != 6 || c.p.* != 6) { return 3; }

    if (take(.U{ .p = new i32{7} }) != 7) { return 4; }

    _ = .U{ .p = new i32{8} };            // 显式丢弃 → 递归释放

    libc::printf("union own payload: ok\n");
    return 0;
}
