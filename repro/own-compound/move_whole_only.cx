// move_whole_only.cx: **正例** —— 聚合只能整体 move（字段级 move 被禁后的正道）
//
// 与 move_field_and_closure.rejected.cx 成对：
//   - 结构体 own 字段不能单独 move（无字段级 TDZ）→ 整体 move 是唯一转移方式
//   - 闭包捕获槽不可 move → 闭包内改用 clone/借用
struct Box { p: own *i32; n: i32; }

// 整体 move：合法
func whole_move(): i32 {
    var b: Box = .Box{ .p = new i32{7}, .n = 1 };
    var c: Box = move(b);              // ✅ 整体 move
    return c.p.*;
}

// 闭包捕获后在体内 clone（不 move 捕获槽）
func capture_then_clone(): i32 {
    var b: Box = .Box{ .p = new i32{8}, .n = 2 };
    var f = func |(c: Box = move(b))| get(): i32 {
        var d: Box = clone(c);         // ✅ clone 捕获槽
        return d.p.*;
    };
    return f();
}

// 闭包捕获 own 指针后借用读取（不 move）
func capture_borrow(): i32 {
    var p: own *i32 = new i32{9};
    var f = func |(q: own *i32 = move(p))| get(): i32 {
        return q.*;                    // ✅ 借用读取
    };
    return f();
}

func main(): i32 {
    if (whole_move() != 7) { return 1; }
    if (capture_then_clone() != 8) { return 2; }
    if (capture_borrow() != 9) { return 3; }
    return 0;
}
