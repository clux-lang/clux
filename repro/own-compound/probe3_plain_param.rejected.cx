// gap4: 参数位规则
//   A) 含 own 字段的复合类型作形参 → 必须写成 fatal T（普通 Box 形参应报错）
//   B) 参数位含 ref 字段 → 必须标注作用域
extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

struct Box { p: own *i32; n: i32; }

// A) 普通 Box 形参（目标：报错，必须 fatal Box）
func plain_param(b: Box): i32 { return b.n; }

func main(): i32 {
    // 构造产 fatel Box 直接传
    var r: i32 = plain_param(.Box{ .p = new i32{1}, .n = 1 });
    return r;
}
