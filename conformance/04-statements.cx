// 04-statements.cx — 语句与控制流（白皮书第 4 章）

/* 用全局数组做副作用记录：defer 体是值捕获，不能写外部局部变量。 */
var trace: [8]i32 = .[8]i32{ 0, 0, 0, 0, 0, 0, 0, 0 };
var trace_len: i32 = 0;

func push(v: i32): void {
    trace[trace_len] = v;
    trace_len = trace_len + 1;
}

func reset_trace(): void {
    trace_len = 0;
    var i: usize = 0usize;
    while (i < 8usize) {
        trace[i] = 0;
        i = i + 1usize;
    }
}

/* ---- 块作用域与遮蔽 ---- */

test "statements.block.scope" {
    var x: i32 = 1;
     {
        var x: i32 = 2;
        assert(x == 2);
         {
            var x: i32 = 3;
            assert(x == 3);
        }
        assert(x == 2);
    }
    assert(x == 1);
}

/* ---- if / else ---- */

test "statements.if" {
    var r: i32 = 0;
    if (true) {
        r = 1;
    } else {
        r = 2;
    }
    assert(r == 1);
    if (false) {
        r = 3;
    } else if (true) {
        r = 4;
    } else {
        r = 5;
    }
    assert(r == 4);
}

/* ---- switch ---- */

test "statements.switch" {
    var out: i32 = 0;
    var v: i32 = 2;
    switch (v) {(1) ->  {
        out = 10;
    } (2, 3) ->  {
        out = 20;
    } default ->  {
        out = 30;
    }}
    assert(out == 20);
    v = 9;
    switch (v) {(1) ->  {
        out = 1;
    } default ->  {
        out = 99;
    }}
    assert(out == 99);
}

/* ---- while / do-while / for ---- */

test "statements.loops" {
    var i: i32 = 0;
    var sum: i32 = 0;
    while (i < 5) {
        sum = sum + i;
        i = i + 1;
    }
    assert(sum == 10);

    var d: i32 = 0;
    do {
        d = d + 1;
    } while (d < 3);
    assert(d == 3);

    var f: i32 = 0;
    for (var k: usize = 0usize; k < 4usize; k = k + 1usize) {
        f = f + 1;
    }
    assert(f == 4);
}

/* ---- foreach ---- */

test "statements.foreach" {
    var a: [4]i32 = .[4]i32{ 1, 2, 3, 4 };
    var sum: i32 = 0;
    foreach (var v of a) {
        sum = sum + v;
    }
    assert(sum == 10);

    var s: []i32 = a[1:3];
    var ssum: i32 = 0;
    foreach (var v of s) {
        ssum = ssum + v;
    }
    assert(ssum == 5);
}

/* ---- break / continue ---- */

test "statements.breakContinue" {
    var i: i32 = 0;
    var sum: i32 = 0;
    while (true) {
        i = i + 1;
        if (i > 10) {
            break;
        }
        if (i % 2 == 0) {
            continue;
        }
        sum = sum + i;
    }
    assert(sum == 25); // 1+3+5+7+9

    var j: i32 = 0;
    var hits: i32 = 0;
    for (var k: i32 = 0; k < 5; k = k + 1) {
        if (k == 2) {
            continue;
        }
        if (k == 4) {
            break;
        }
        hits = hits + 1;
    }
    assert(hits == 3);
}

/* ---- return ---- */

func early(x: i32): i32 {
    if (x < 0) {
        return -1;
    }
    if (x == 0) {
        return 0;
    }
    return 1;
}

test "statements.return" {
    assert(early(-5) == -1);
    assert(early(0) == 0);
    assert(early(5) == 1);
}

/* ---- defer：作用域退出逆序执行 ---- */

test "statements.defer.lifo" {
    reset_trace();
     {
        defer {
            push(1);
        }
        defer {
            push(2);
        }
        push(0);
    }
    assert(trace_len == 3);
    assert(trace[0] == 0);
    assert(trace[1] == 2);
    assert(trace[2] == 1);
}

test "statements.defer.capture" {
    reset_trace();
    var captured: i32 = 42;
     {
        defer |captured| {
            push(captured);
        }
        captured = 0; // 值捕获：defer 看到的是登记时的值
        push(7);
    }
    assert(trace[0] == 7);
    assert(trace[1] == 42);
}

test "statements.defer.onReturn" {
    reset_trace();
    var r: i32 = with_defer(3);
    assert(r == 3);
    assert(trace_len == 1);
    assert(trace[0] == 99);
}

func with_defer(x: i32): i32 {
    defer {
        push(99);
    }
    return x;
}

/* ---- using 与 defer 共用退出顺序 ---- */

struct Guard {
    var disposed: i32 = 0;
    id: i32;
    func __dispose__(self: *Guard): void {
        Guard::disposed = Guard::disposed + 1;
    }
}

test "statements.using" {
    reset_trace();
    var before: i32 = Guard::disposed;
     {
        using g = .Guard{ .id = 1 };
        defer {
            push(1);
        }
        push(0);
    }
    assert(Guard::disposed == before + 1);
    assert(trace_len == 2);
    assert(trace[0] == 0);
}

/* ---- static_assert ---- */

test "statements.staticAssert" {
    static_assert(sizeof(i32) == 4usize, "i32 is 4 bytes");
    static_assert(true, "trivially true");
    assert(true);
}

/* ---- comptime if / comptime foreach ---- */

comptime var N = 3;

test "statements.comptimeIf" {
    var v: i32 = 0;
    comptime if (N == 3) {
        v = 1;
    } else {
        v = 2;
    }
    assert(v == 1);
}

test "statements.comptimeForeach" {
    var seq: [3]i32 = .[3]i32{ 1, 2, 3 };
    var sum: i32 = 0;
    foreach (var e of seq) {
        sum = sum + e;
    }
    assert(sum == 6);
}

/* ---- 空语句 ---- */

test "statements.empty" {
    ;
    var a: i32 = 1;
    assert(a == 1);
}
