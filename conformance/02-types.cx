// 02-types.cx — 类型系统（白皮书第 2 章）

test "types.integer.widths" {
    var a: i8 = 127i8;
    var b: i8 = -127i8;
    var c: u8 = 255u8;
    var d: i16 = -32767i16;
    var e: u16 = 65535u16;
    var f: i32 = -2147483647i32;
    var g: u32 = 4294967295u32;
    var h: i64 = 9223372036854775807i64;
    var i: u64 = 18446744073709551615u64;
    assert(a > b);
    assert(c > a as u8);
    assert(d < 0i16);
    assert(e > 0u16);
    assert(f < 0i32);
    assert(g > 0u32);
    assert(h > 0i64);
    assert(i > 0u64);
    assert(sizeof(i8) == 1usize);
    assert(sizeof(i16) == 2usize);
    assert(sizeof(i32) == 4usize);
    assert(sizeof(i64) == 8usize);
}

test "types.integer.conversions" {
    var small: i32 = 7i32;
    var wide: i64 = small as i64;
    assert(wide == 7i64);
    var back: i32 = wide as i32;
    assert(back == 7i32);
    var u: u32 = 300u32;
    var n: i64 = u as i64;
    assert(n == 300i64);
    // 拓宽是隐式转换；收窄必须 as
    var implicit_wide: i64 = small;
    assert(implicit_wide == 7i64);
}

test "types.bool" {
    var t: bool = true;
    var f: bool = false;
    assert(t != f);
    assert(!f);
    assert(t && !f);
    assert(t || f);
    assert(sizeof(bool) == 1usize);
}

test "types.str" {
    var s: str = "hello";
    var empty: str = "";
    assert(len(s) == 5usize);
    assert(len(empty) == 0usize);
    var bytes: []const u8 = s[:];
    assert(bytes[0] == 'h');
    assert(bytes[4] == 'o');
}

test "types.float" {
    var a: f32 = 1.5f32;
    var b: f64 = 2.5f64;
    assert(a < 2.0f32);
    assert(b > a as f64);
    assert(sizeof(f32) == 4usize);
    assert(sizeof(f64) == 8usize);
    var i: i32 = 3;
    assert(i as f64 == 3.0f64);
    var truncated: i32 = 3.9f64 as i32;
    assert(truncated == 3i32);
}

test "types.array" {
    var a: [3]i32 = .[3]i32{ 1, 2, 3 };
    assert(len(a) == 3usize);
    assert(a[0] == 1);
    assert(a[2] == 3);
    a[1] = 20;
    assert(a[1] == 20);
    assert(sizeof([3]i32) == 12usize);
    var empty: [0]i32 = .[0]i32{};
    assert(len(empty) == 0usize);
}

test "types.slice" {
    var a: [4]i32 = .[4]i32{ 10, 20, 30, 40 };
    var all: []i32 = a[:];
    var mid: []i32 = a[1:3];
    assert(len(all) == 4usize);
    assert(len(mid) == 2usize);
    assert(mid[0] == 20);
    assert(mid[1] == 30);
    // 切片是视图：写视图即写原数组
    mid[0] = 99;
    assert(a[1] == 99);
}

test "types.pointer" {
    var v: i32 = 7;
    var p: *i32 = v.&;
    assert(p.* == 7);
    p.* = 8;
    assert(v == 8);
    var q: *const i32 = v.&;
    assert(q.* == 8);
}

test "types.optional" {
    var some: ?i32 = 5;
    var none: ?i32 = nil;
    assert(some != nil);
    assert(none == nil);
    assert(some.! == 5);
    var taken: i32 = take_opt(some);
    assert(taken == 5);
    assert(some == nil);
    var o: ?str = nil;
    o = "x";
    assert(o.! == "x");
}

test "types.tuple" {
    var t: <i32, i64> = .<i32, i64>{ 1, 2000000000 };
    assert(t[0] == 1);
    assert(t[1] == 2000000000);
    t[0] = 2;
    assert(t[0] == 2);
    var u: <i32, i32> = .{ 3, 4 };
    assert(u[0] + u[1] == 7);
}

struct Point {
    x: i32;
    y: i64;
}
enum Color: i32 {Red = 1, Green = 2}
union Shape { radius: f32; side: i32 }
cunion Bits { i: i32; f: f32 }

test "types.aggregates" {
    var p: Point = .Point{
        .x = 1,
        .y = 2
    };
    assert(p.x == 1);
    assert(p.y == 2i64);
    var c: Color = Color::Green;
    assert(c == Color::Green);
    var s: Shape = .Shape{ .radius = 1.5f32 };
    assert(s is radius);
    assert(!(s is side));
    var b: Bits = .Bits{ .i = 1065353216 };
    assert(b.i == 1065353216);
    assert(b.f == 1.0f32);
}

test "types.qualifiers" {
    var c: const i32 = 3;
    assert(c == 3);
    var v: volatile i32 = 4;
    assert(v == 4);
    var cv: const volatile i32 = 5;
    assert(cv == 5);
}

test "types.asAndExtends" {
    var a: i32 = 1;
    var b: i64 = a as i64;
    assert(b == 1i64);
    // extends 是编译期类型运算：同类型 / const 兼容为真，不同类型为假
    assert(i32 extends i32);
    assert(!(i32 extends i64));
    assert(const i32 extends i32);
    assert(!([2]i32 extends [3]i32));
}

test "types.sizeofAlignofTypeof" {
    assert(sizeof(i32) == 4usize);
    assert(alignof(i64) == 8usize);
    assert(sizeof(Point) == 16usize);
    var v: i16 = 1i16;
    assert(typeof(v).name == "i16");
    assert(sizeof(typeof(v)) == sizeof(i16));
}

test "types.void" {
    assert(noop() == 5);
}

func noop(): i32 {
    return 5;
}

test "types.sizeofTypeExpressions" {
    // sizeof / alignof 接受任意类型表达式；`*T` 前缀只有类型位置才有
    assert(sizeof(*i32) == sizeof(usize));
    assert(sizeof(**i32) == sizeof(*i32));
    assert(sizeof(*[]i32) == sizeof(usize));
    assert(sizeof(*?i32) == sizeof(usize));
    assert(sizeof(*const i32) == sizeof(*i32));
    assert(sizeof([]i32) == 2usize * sizeof(usize));
    assert(sizeof([3]i32) == 12usize);
    assert(alignof(*i64) == alignof(usize));
}

test "types.optionalValueConstruction" {
    // ?T 直接接受 T 值与 nil（所有初始化位置），不需要写 .?T{...}
    var a: ?i32 = 123;
    var b: ?i32 = nil;
    assert(a.! == 123);
    assert(b == nil);
    assert(take_opt_i32(7) == 7);
    assert(take_opt_i32(nil) == -1);
    var s: OptHolder = .OptHolder{ .o = 5 };
    assert(s.o.! == 5);
    var f: ?i32 = give_opt(9);
    assert(f.! == 9);
}

struct OptHolder {
    o: ?i32;
}

func take_opt_i32(o: ?i32): i32 {
    if (o == nil) {
        return -1;
    }
    return o.!;
}

func give_opt(v: i32): ?i32 {
    return v;
}
