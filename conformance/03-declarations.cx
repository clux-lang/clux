// 03-declarations.cx — 声明（白皮书第 3 章）

/* ---- 函数 ---- */

func add(a: i32, b: i32): i32 { return a + b; }
func no_ret(x: i32): void { }

test "declarations.func" {
    assert(add(2, 3) == 5);
    no_ret(1);
    var f: func(i32, i32) -> i32 = add;
    assert(f(4, 5) == 9);
}

/* ---- 结构体：字段 / 方法 / 静态属性 ---- */

struct Counter {
    var total: i32 = 0; // 静态属性（类型级）
    value: i32;

    func bump(self: *Counter, by: i32): void {
        self.value = self.value + by;
        Counter::total = Counter::total + 1;
    }
    func get(self: *Counter): i32 { return self.value; }

    // 魔法方法：具名构造被禁用，`.Counter{ start }` = 零初始化 + __init__
    func __init__(self: *Counter, start: i32): void { self.value = start; }
}

test "declarations.struct" {
    var c: Counter = .Counter{ 1 };
    assert(c.get() == 1);
    c.bump(4);
    assert(c.get() == 5);
    var t: i32 = Counter::total;
    assert(t >= 1);
    c.bump(0);
    assert(Counter::total == t + 1);
}

/* ---- 类型别名 ---- */

type Ints = [3]i32;
type Callback = func(i32) -> i32;

test "declarations.typeAlias" {
    var a: Ints = .[3]i32{ 1, 2, 3 };
    assert(a[2] == 3);
    var f: Callback = add2;
    assert(f(5) == 7);
}

func add2(x: i32): i32 { return x + 2; }

/* ---- enum：底层类型与变体值 ---- */

enum Color: i32 { Red = 1, Green = 2, Blue = 7 }

test "declarations.enum" {
    var c: Color = Color::Blue;
    assert(c as i32 == 7);
    var r: Color = Color::Red;
    assert(r != c);
    assert(Color::Green as i32 == 2);
}

/* ---- 运算符魔法方法 ---- */

struct Vec2 {
    x: i32;
    y: i32;

    func __add__(self: *Vec2, rhs: *Vec2): Vec2 {
        return .Vec2{ .x = self.x + rhs.x, .y = self.y + rhs.y };
    }
    func __eq__(self: *Vec2, rhs: *Vec2): bool {
        return self.x == rhs.x && self.y == rhs.y;
    }
    func __index__(self: *Vec2, i: i32): *i32 {
        return i == 0 ? self.x.& : self.y.&;
    }
    func __len__(self: *Vec2): usize { return 2usize; }
}

test "declarations.magicOperators" {
    var a: Vec2 = .Vec2{ .x = 1, .y = 2 };
    var b: Vec2 = .Vec2{ .x = 10, .y = 20 };
    var s: Vec2 = a + b;
    assert(s.x == 11 && s.y == 22);
    assert(a == a);
    assert(!(a == b));
    assert(a[0] == 1);
    assert(a[1] == 2);
    assert(len(a) == 2usize);
}

/* ---- interface / implements ---- */

interface Sized[T] {
    func size_of(self: *T): usize;
}

struct Box implements Sized[Box] {
    n: i32;
    func size_of(self: *Box): usize { return sizeof(Box); }
}

test "declarations.interface" {
    var b: Box = .Box{ .n = 1 };
    assert(b.size_of() == sizeof(Box));
}

/* ---- using + __dispose__ ---- */

struct Guard {
    id: i32;
    func __dispose__(self: *Guard): void { Guard::disposed = Guard::disposed + 1; }
    var disposed: i32 = 0;
}

test "declarations.using" {
    var before: i32 = Guard::disposed;
    {
        using g = .Guard{ .id = 1 };
        assert(g.id == 1);
    }
    assert(Guard::disposed == before + 1);
}

/* ---- comptime var / comptime func ---- */

comptime var LIMIT = 3;

comptime func triple(n: i32): i32 { return n * 3; }

test "declarations.comptime" {
    assert(LIMIT == 3);
    assert(triple(4) == 12);
    var a: [LIMIT]i32 = .[3]i32{ 1, 2, 3 };
    assert(len(a) == 3usize);
    assert(a[triple(0)] == 1);
}

/* ---- defer 属于语句层（见 04-statements），这里只验证声明顺序自由 ---- */

test "declarations.orderIndependent" {
    assert(later(1) == 2);
}

func later(x: i32): i32 { return x + 1; }
