// 03-magic.cx — 魔法方法（白皮书 §3.15）
//
// 结构体方法名以 `__name__` 结尾时，对应语法位置改写为普通方法调用。
// 这里覆盖 §3.15.2 方法表的每一行，以及 §3.15.1 / §3.15.6 的派发规则。

/* ---- 3.15.3 运算符：二元 / 一元 / 比较 ---- */

struct Num {
    v: i32;

    func __add__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v + o.v };
    }
    func __sub__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v - o.v };
    }
    func __mul__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v * o.v };
    }
    func __div__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v / o.v };
    }
    func __mod__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v % o.v };
    }

    func __and__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v & o.v };
    }
    func __or__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v | o.v };
    }
    func __xor__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v ^ o.v };
    }
    func __shl__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v << o.v };
    }
    func __shr__(self: *const Num, o: *const Num): Num {
        return .Num{ .v = self.v >> o.v };
    }

    func __neg__(self: *const Num): Num {
        return .Num{ .v = -self.v };
    }
    func __bnot__(self: *const Num): Num {
        return .Num{ .v = ~self.v };
    }
    func __not__(self: *const Num): bool {
        return self.v == 0;
    }

    func __eq__(self: *const Num, o: *const Num): bool {
        return self.v == o.v;
    }
    func __lt__(self: *const Num, o: *const Num): bool {
        return self.v < o.v;
    }
    func __le__(self: *const Num, o: *const Num): bool {
        return self.v <= o.v;
    }
    func __gt__(self: *const Num, o: *const Num): bool {
        return self.v > o.v;
    }
    func __ge__(self: *const Num, o: *const Num): bool {
        return self.v >= o.v;
    }
}

test "magic.arithmetic" {
    var a: Num = .Num{ .v = 7 };
    var b: Num = .Num{ .v = 3 };
    assert((a + b).v == 10);
    assert((a - b).v == 4);
    assert((a * b).v == 21);
    assert((a / b).v == 2);
    assert((a % b).v == 1);
}

test "magic.bitwise" {
    var a: Num = .Num{ .v = 12 }; // 0b1100
    var b: Num = .Num{ .v = 10 }; // 0b1010
    assert((a & b).v == 8);
    assert((a | b).v == 14);
    assert((a ^ b).v == 6);
    assert((a << b).v == 12288);
    assert((a >> b).v == 0); // 12 >> 10 == 0
}

test "magic.unary" {
    var a: Num = .Num{ .v = 5 };
    assert((-a).v == -5);
    assert((~a).v == -6);
    assert(!a == false); // __not__ 返回 v == 0
    var z: Num = .Num{ .v = 0 };
    assert(!z);
}

test "magic.comparison" {
    var a: Num = .Num{ .v = 1 };
    var b: Num = .Num{ .v = 2 };
    assert(a == a);
    assert(a != b); // `!=` 自动取反 __eq__
    assert(a < b);
    assert(a <= a);
    assert(b > a);
    assert(b >= b);
}

test "magic.compoundAssignUsesOperator" {
    var a: Num = .Num{ .v = 1 };
    var b: Num = .Num{ .v = 2 };
    a = a + b; // 复合赋值 a += b 同样是 a.__add__(b.&)
    assert(a.v == 3);
    a = a * b;
    assert(a.v == 6);
}

/* ---- 3.15.4 下标与切片 ---- */

struct Buf {
    items: []i32;

    func __len__(self: *const Buf): usize {
        return len(self.items);
    }

    func __index__(self: *Buf, i: i32): *i32 {
        return self.items[i].&;
    }

    func __slice__(self: *Buf, lo: usize, hi: usize): []i32 {
        return self.items[lo:hi];
    }
}

test "magic.indexReadWrite" {
    var raw: [4]i32 = .[4]i32{ 7, 8, 9, 10 };
    var b: Buf = .Buf{ .items = raw[:] };
    assert(b[1] == 8);
    b[1] = 20;
    assert(b[1] == 20);
    assert(raw[1] == 20); // 写穿到底层存储
    b[2] += 5;
    assert(b[2] == 14);
}

test "magic.len" {
    var raw: [3]i32 = .[3]i32{ 1, 2, 3 };
    var b: Buf = .Buf{ .items = raw[:] };
    assert(len(b) == 3usize);
}

test "magic.slice" {
    var raw: [4]i32 = .[4]i32{ 1, 2, 3, 4 };
    var b: Buf = .Buf{ .items = raw[:] };
    // 两个边界总是有实参：省略下界 = 0，省略上界 = len(b)
    var all: []i32 = b[:];
    assert(len(all) == 4usize);
    assert(all[0] == 1);
    assert(all[3] == 4);
    var mid: []i32 = b[1:3];
    assert(len(mid) == 2usize);
    assert(mid[0] == 2);
    var tail: []i32 = b[2:];
    assert(len(tail) == 2usize);
    assert(tail[0] == 3);
    var head: []i32 = b[:2];
    assert(len(head) == 2usize);
    assert(head[1] == 2);
}

/* ---- 3.15.5 访问回退 ---- */

struct Inner {
    n: i32;
}

struct Wrap {
    inner: *Inner;

    func __deref__(self: *const Wrap): *Inner {
        return self.inner;
    }
}

test "magic.derefMemberFallback" {
    var inner: Inner = .Inner{ .n = 42 };
    var w: Wrap = .Wrap{ .inner = inner.& };
    assert(w.n == 42); // w.n ⇒ w.__deref__().n
    w.n = 7;
    assert(inner.n == 7);
    assert(w.*.n == 7); // w.* ⇒ 解引用到 Inner
}

/* ---- 3.15.5 生命周期：__init__ / __assign__ / __dispose__ ---- */

struct Counter {
    n: i32;
    var assigns: i32 = 0;
    var disposes: i32 = 0;

    func __init__(self: *Counter, start: i32): void {
        self.n = start;
    }

    func __assign__(self: *Counter, rhs: *const Counter): void {
        self.n = rhs.n;
        Counter::assigns = Counter::assigns + 1;
    }

    func __dispose__(self: *Counter): void {
        Counter::disposes = Counter::disposes + 1;
    }
}

test "magic.init" {
    var c: Counter = .Counter{ 5 }; // 零初始化 + __init__(5)
    assert(c.n == 5);
    // 单参数 __init__ 支持隐式构造
    var d: Counter = 9;
    assert(d.n == 9);
}

test "magic.assignNotOnInit" {
    var c: Counter = .Counter{ 1 };
    var before: i32 = Counter::assigns;
    // 初始化走 __init__（不是 __assign__）。从同类型值初始化会因 __init__ 的
    // 形参不匹配而被拒绝——这正是 move-only 类型禁止 copy 的位置（§3.15）。
    var d: Counter = 2;
    assert(d.n == 2);
    assert(Counter::assigns == before);
    d = c; // 赋值：派发 __assign__
    assert(Counter::assigns == before + 1);
    assert(d.n == 1);
}

test "magic.dispose" {
    var before: i32 = Counter::disposes;
     {
        using c = .Counter{ 1 };
        assert(c.n == 1);
    }
    assert(Counter::disposes == before + 1);
}

/* ---- 3.15.1 泛型魔法方法 ---- */

struct Pair {
    a: i32;
    b: i32;

    func __add__[U](self: *const Pair, rhs: *const U): Pair {
        return .Pair{
            .a = self.a + rhs.* as i32,
            .b = self.b + rhs.* as i32
        };
    }
}

test "magic.genericMethod" {
    var p: Pair = .Pair{
        .a = 1,
        .b = 2
    };
    var q: Pair = p + 5; // U = i32（标量右操作数也可以）
    assert(q.a == 6 && q.b == 7);
}

/* ---- 3.15.3 聚合内部判等走 __eq__ ---- */

struct AlwaysEq {
    v: i32;
    func __eq__(self: *const AlwaysEq, o: *const AlwaysEq): bool {
        return true;
    }
}

struct Holder {
    e: AlwaysEq;
    k: i32;
}

test "magic.eqInsideAggregate" {
    var a: Holder = .Holder{
        .e = .AlwaysEq{ .v = 1 },
        .k = 1
    };
    var b: Holder = .Holder{
        .e = .AlwaysEq{ .v = 2 },
        .k = 1
    };
    assert(a == b); // 字段 e 用 AlwaysEq.__eq__ → 视为相等
    var c: Holder = .Holder{
        .e = .AlwaysEq{ .v = 1 },
        .k = 2
    };
    assert(a != c); // k 不同
}

/* ---- dispose(x)：按类型决定是否调用 __dispose__ ---- */

struct Tracked {
    n: i32;
    var disposed: i32 = 0;
    func __dispose__(self: *Tracked): void {
        Tracked::disposed = Tracked::disposed + 1;
    }
}

struct Untracked {
    v: i32;
}

test "magic.disposeStatement" {
    var before: i32 = Tracked::disposed;
    var t: Tracked = .Tracked{ .n = 1 };
    dispose(t.&); // 有 __dispose__ → 调用
    assert(Tracked::disposed == before + 1);
    var u: Untracked = .Untracked{ .v = 2 };
    dispose(u.&); // 没有 → 静默
    dispose(u); // 值接收者也一样静默
    assert(Tracked::disposed == before + 1);
    var t2: Tracked = .Tracked{ .n = 3 };
    dispose(t2); // 值接收者 + 有 __dispose__ → 调用
    assert(Tracked::disposed == before + 2);
}

/* ---- 同类型初始化走 __init_copy__：var / 实参 / 返回值都是 move ---- */

struct Mover[T] {
    ptr: ?*T;

    /* 裸指针构造 */
    func __init__(self: *Mover[T], p: *T): void {
        self.ptr = p;
    }

    /* 同类型初始化 = move（参数传递、返回值、var 初始化、构造都走这里） */
    func __init_copy__(self: *Mover[T], o: *Mover[T]): void {
        self.ptr = o.take();
    }

    func take(self: *Mover[T]): ?*T {
        var p: ?*T = self.ptr;
        self.ptr = nil;
        return p;
    }

    func __assign__(self: *Mover[T], o: *Mover[T]): void {
        self.ptr = o.ptr;
        o.ptr = nil;
    }
}

var mover_val: i32 = 42;

func mover_give(): Mover[i32] {
    return .Mover[i32]{ mover_val.& };
}

func mover_take(m: Mover[i32]): i32 {
    if (m.ptr == nil) {
        return -1;
    }
    return m.ptr.!.*;
}

test "magic.initCopy" {
    var v: i32 = 7;
    var a: Mover[i32] = .Mover[i32]{ v.& };

    // var 初始化
    var b: Mover[i32] = a;
    assert(a.ptr == nil);
    assert(b.ptr.!.* == 7);

    // 实参传递
    assert(mover_take(b) == 7);
    assert(b.ptr == nil);

    // 返回值
    var c: Mover[i32] = mover_give();
    assert(c.ptr.!.* == 42);

    // 赋值 → __assign__
    var d: Mover[i32] = .Mover[i32]{ v.& };
    d = c;
    assert(c.ptr == nil);
    assert(d.ptr.!.* == 42);
}

/* ---- 泛型 __init__[U]：按实参推断实例化 ---- */

struct PtrHold[T] {
    ptr: ?*T;

    func __init__[U](self: *PtrHold[T], src: U): void {
        comptime if (U extends *T) {
            self.ptr = src;
        } else {
            self.ptr = nil;
        }
    }
}

test "magic.initGeneric" {
    var v: i32 = 11;
    var h: PtrHold[i32] = .PtrHold[i32]{ v.& }; // U = *i32
    assert(h.ptr != nil);
    assert(h.ptr.!.* == 11);
}

/* ---- __call__：struct 可被调用 ---- */

struct Adder {
    base: i32;

    func __call__(self: *Adder, x: i32): i32 {
        return self.base + x;
    }
}

struct Ticker {
    n: i32;

    func __call__(self: *Ticker): void {
        self.n = self.n + 1;
    }
}

func apply_adder(a: Adder, v: i32): i32 {
    return a(v);
}

test "magic.call" {
    var a: Adder = .Adder{ .base = 40 };
    assert(a(2) == 42);
    assert(apply_adder(a, 1) == 41);

    var t: Ticker = .Ticker{ .n = 0 };
    t();
    t();
    assert(t.n == 2);
}
