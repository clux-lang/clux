# ============================================================================
# 换行与编码约定
#
# 1. 全仓统一 **LF**：Windows 上编辑器默认写入 CRLF，会让 diff 出现
#    "整文件重写"的假象（曾实测 +1071/−1062 的噪声），故在此强制。
#    `eol=lf` 让 Git 在工作区也检出 LF（否则 Windows 默认会转成 CRLF）。
# 2. 编码统一 **UTF-8 无 BOM**，由 `tools/check_encoding.py` 校验。
#    （third_party 的 MSVC 工程文件需要 BOM 才能被识别为 UTF-8，该脚本对其豁免。）
# ============================================================================

* text=auto eol=lf

# ---- 二进制：不参与换行/文本转换 ----
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.dll  binary
*.exe  binary
*.lib  binary
*.so   binary
*.dylib binary
*.a    binary
*.obj  binary
*.pdb  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.cxb  binary

# ---- submodule（各自仓库有自己的约定）----
third_party/gtest/**   -text
third_party/libffi/**  -text
