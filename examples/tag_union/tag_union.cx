// tag_union.cx -- tag union（标签联合：tag 前缀 + member payload 联合体）
//
//   声明     union Name { field: type; ... }
//           与 struct 同构平铺字段语法，仅关键字不同；字段名 = tag 名 =
//           member 名，字段类型 = payload 类型；每个字段即一个 member
//   布局     data = [tag 整数（宽度按 member_count 自适应 1/2/4/8）] +
//           [payload 联合体（自 payload_offset 起，C 对齐）]；单字段无内部偏移
//   构造     .Shape{.radius = 1.5f32 }（强制恰好 1 个具名字段；字段名 =
//           member 名；显式 tag 哨兵消除同类型 member 歧义）
//   判 tag   `s is radius`（IS_TAG 指令比较 tag 整数，返回 bool）
//   访问     s.radius 读 / s.radius = v 写：FIELD_GET/FIELD_SET 运行时按 tag
//           反查所属 member；tag 不符 → error value（引擎级硬错误 = panic，
//           对齐数组越界）
//   实现     构造 → CONSTRUCT（union 分支）；判 tag → IS_TAG；访问 → FIELD_GET/SET

// 全局 union：平铺字段 = 三个 member（radius/w/h，各持独立 payload 类型）
union Shape {
  radius: f32;
  w: f32;
  h: f32;
}

func main(): i32 {
    // 单字段强制构造：字段名 = member 名，tag 由编译器按名定位
    var s = .Shape{.radius = 1.5f32};

    // tag 判定：`s is Member` 返回 bool
    if (s is radius != true)  { return 1; }
    if (s is w != false)      { return 2; }
    if (s is h != false)      { return 3; }

    // 字段访问：当前 tag 的 member 字段可直接读写
    var r = s.radius;
    if (r != 1.5f32) { return 4; }
    s.radius = 2.5f32;
    if (s.radius != 2.5f32) { return 5; }

    // 另一 member 构造：tag 切换，字段按当前 tag 访问
    var e = .Shape{.w = 3.0f32};
    if (e is w != true)        { return 6; }
    if (e is radius != false)  { return 7; }

    // union 变量赋值：同 union 类型间
    var s2: Shape = s;
    if (s2.radius != 2.5f32) { return 8; }

    return 0;
}
