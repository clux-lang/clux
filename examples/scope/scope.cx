// scope.cx — 样例：词法作用域与遮蔽
//
//   - 块作用域：{ } 引入新作用域，内层块可访问外层变量，出块不可见
//   - 变量遮蔽：内层 var 与外层同名时遮蔽外层，出块恢复
//   - type 遮蔽：局部 type def 遮蔽全局同名 type（提升遮蔽——整块生效，
//     与定义位置无关），出块恢复全局定义
//   - 局部 type 前向引用：定义在后、使用在前合法（提升机制）

type T = i32; // 全局 type

func main(): i32 {
    var g: i32 = 1;

    {
        // ---- 局部变量遮蔽外层 ----
        var g: i32 = 2;
        printf("inner g = %d\n", g);

        // ---- 局部 type 遮蔽全局 type（提升遮蔽，块内全范围生效）----
        type T = i64;
        var t: T = 5; // t 是 i64（局部 T），非全局 i32
        printf("t = %d\n", t as i32);
    }

    // 出块：恢复外层变量与全局 type
    printf("outer g = %d\n", g);
    var x: T = 7; // 全局 T（i32）
    printf("x = %d\n", x);

    // ---- 前向引用 + 嵌套块 ----
    {
        var y: Inner = 9; // 使用在前
        type Inner = i32; // 定义在后（提升）
        printf("y = %d\n", y);
    }
    // var z: Inner = 1; // 出块不可见（反注释可验证编译错误）

    return 0;
}
