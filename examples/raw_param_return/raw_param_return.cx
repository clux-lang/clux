extern lib libc from "*";
extern cfunc libc::printf(format: str, ...): i32;

struct Box {
    v: i32;
}

// 裸指针形参：函数只借用，不接管所有权
func read_i32(p: *i32): i32 { return p.*; }
func read_box(p: *Box): Box { return p.*; }
func read_box_field(p: *Box): i32 { return p.*.v; }

func main(): i32 {
    var p1 = new i32{ 42 };
    var b1 = new Box{ .v = 43 };
    var b2 = new Box{ .v = 44 };

    var rc: i32 = 0;
    if (read_i32(p1) != 42) { rc = 1; }
    var r = read_box(b1);
    if (r.v != 43) { rc = 2; }
    if (read_box_field(b2) != 44) { rc = 3; }

    free(p1);
    free(b1);
    free(b2);
    return rc;
}
