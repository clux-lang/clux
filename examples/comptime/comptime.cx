extern lib libc from "*";
extern cfunc libc::printf(format: str, ...): void;
comptime func add(a: i32, b: i32): i32 {
    return a + b;
}

comptime var BASE: const i32 = 100;
comptime var SUM = add(BASE, 23);

func main(): void {
    libc::printf("%d\n", SUM);
    libc::printf("%d\n", add(1, 2));
    var local = SUM + add(5, 5);
    libc::printf("%d\n", local);
}
