// recursive_struct.cx — 样例：递归结构体（自引用 / 互相引用）
//
// 自第 73 项起，clux 的结构体字段类型**允许成环**，只要环经过"布局不依赖被引用
// 类型完整布局"的包装：
//   - 指针族（own/ref/fatal/share/weak *T）：指针宽恒定；
//   - 切片（own []T / ref []T）：切片头 = 2 指针宽；
//   - 函数签名（func(ref *const T) -> R）：签名宽 = func_t*；
//   - const / volatile、数组 [N]T：布局派生自 sub/elem，在 sub 定型后**延迟定型**。
//
// **按值递归**（struct A { a: A; }、[N]A 直接内联自身、?A）仍然被拒——必然无限
// 大小，报：
//   error: struct 'A': field 'a' has incomplete type 'A': recursive struct by value
//          (break the cycle with a pointer, e.g. 'ref *A')
//
// 定义顺序无关：字段可以点名**后面**才声明的结构体（不需要前置声明）。
//
// 本文件三种形态各来一个：
//   1. 单链表（Node.next）+ 结构体方法（Node::sum 沿 next 遍历）；
//   2. 二叉树（Tree.left/right）+ 递归函数（depth）；
//   3. 互相引用（Parent ↔ Child）。

extern lib "*" as libc;
extern func libc::printf(format: str, ...): void;

// ---- 1. 单链表：自引用指针字段 + 方法 ----
struct Node {
    v: i32;
    next: ?ref *const Node;

    // 方法：接收者是自己，方法体里沿 next 走（`self` 是普通第一参数，不是关键字）
    func sum(self: ref *const Node): i32 {
        var acc: i32 = 0;
        var cur: ref *const Node = self;
        while (true) {
            acc += cur.v;
            var nx: '<*> ?ref *const Node = cur.next;
            if (nx == nil) { break; }
            cur = nx.!;
        }
        return acc;
    }
}

// ---- 2. 二叉树：两个自引用字段 + 递归函数 ----
struct Tree {
    v: i32;
    left: ?ref *const Tree;
    right: ?ref *const Tree;
}

func depth(t: ref *const Tree): i32 {
    var l: i32 = 0;
    var r: i32 = 0;
    var ln: '<*> ?ref *const Tree = t.left;
    if (ln != nil) { l = depth(ln.!); }
    var rn: '<*> ?ref *const Tree = t.right;
    if (rn != nil) { r = depth(rn.!); }
    if (l > r) { return l + 1; }
    return r + 1;
}

// ---- 3. 互相引用：Parent 点名 Child，Child 又点名 Parent（都写在字段里） ----
struct Parent {
    name: i32;
    first: ?ref *const Child;
}

struct Child {
    label: i32;
    owner: ?ref *const Parent;
}

// ---- 4. 函数类型字段的签名点名自身（手写虚表的"类型安全"写法） ----
//      （需要下转型时仍应改用 opaque，见 examples/manual_vtable）
struct Shape {
    area: func(ref *const Shape) -> i32;
    r: i32;
}

func square_area(s: ref *const Shape): i32 { return s.r * s.r; }

func main(): i32 {
    // 1) 链表：a <- b <- c（c 在头）
    var a: '<*> Node = .Node{ .v = 1, .next = .?ref *const Node{nil} };
    var b: '<*> Node = .Node{ .v = 2, .next = a.& };
    var c: '<*> Node = .Node{ .v = 3, .next = b.& };
    if (c.sum() != 6) { return 1; }                 // 方法糖：接收者 ref *Node → ref *const Node
    if (Node::sum(c.&) != 6) { return 2; }          // 显式限定调用
    if (c.next.!.next.!.v != 1) { return 3; }       // 逐级解包 + 字段访问

    // 2) 二叉树：root -> (mid -> leaf, leaf)
    var leaf: '<*> Tree = .Tree{ .v = 1, .left = .?ref *const Tree{nil},
                                 .right = .?ref *const Tree{nil} };
    var mid: '<*> Tree = .Tree{ .v = 2, .left = leaf.&,
                                .right = .?ref *const Tree{nil} };
    var root: '<*> Tree = .Tree{ .v = 3, .left = mid.&, .right = leaf.& };
    if (depth(root.&) != 3) { return 4; }
    if (depth(leaf.&) != 1) { return 5; }

    // 3) 互相引用：走一圈 Parent → Child → Parent
    var p: '<*> Parent = .Parent{ .name = 7, .first = .?ref *const Child{nil} };
    var ch: '<*> Child = .Child{ .label = 9, .owner = p.& };
    p.first = ch.&;
    if (ch.owner.!.name != 7) { return 6; }
    if (p.first.!.label != 9) { return 7; }

    // 4) 自引用签名的函数字段：槽里放实现，经字段调用
    var sq: '<*> Shape = .Shape{ .area = square_area, .r = 5 };
    if (sq.area(sq.&) != 25) { return 8; }

    // 布局：含 ?ref *const Node 的 Node = i32 + 对齐 + option{bool;ptr} = 24 字节
    if (sizeof(Node) != 24u64) { return 9; }
    if (sizeof([2]Node) != 2u64 * sizeof(Node)) { return 10; }

    libc::printf("recursive_struct: list_sum=%d depth=%d parent=%d child=%d shape_area=%d sizeof(Node)=%llu\n",
                 c.sum(), depth(root.&), ch.owner.!.name, p.first.!.label,
                 sq.area(sq.&), sizeof(Node));
    return 0;
}
