// tuples.cx -- tuple（元组类型：<T1,T2,...> 值构造 + 下标访问）
//
//   类型     <T1, T2, ...>（类型即表达式，原子位置 '<' 解析为元组类型；
//           比较运算符 '<' 是中缀，构造字段链 <v,N> 是 fill 值包——三处互不重叠）
//   布局     C 对齐规则：offset_0=0；offset_i=align_up(prev_end, align_i)；
//           size=align_up(last_end, max_align)；align=max(元素 align)
//   构造     具名 .<i32,i32>{ 0, 1 }；匿名 .{ 0, 1 }（按序推断匿名 tuple 类型，
//           与目标同构时 intern 去重为同一实例，天然零转换）
//   访问     t[0] 读（INDEX_GET 按位置，越界运行期 panic）；
//           t[0] = v 写（INDEX_SET 隐式转换 + 深拷贝回写）
//   兼容     元素类型（type_equal）+ 顺序一致 ⟹ 布局相同，可互赋值/判等
//           （鸭子类型，与 struct 同款）
//   实现     构造 → CONSTRUCT；读 → INDEX_GET（借用引用零拷贝）；
//           写 → INDEX_SET（隐式转换 + 深拷贝回写）

func main(): i32 {
    // 具名构造：.T{...} 按元素序布值
    var t: <i32, i32> = .<i32, i32>{1, 2};
    if (t[0] != 1 || t[1] != 2) {
        return 1;
    }
    t[0] = 5;
    if (t[0] != 5) {
        return 1;
    }
    t[1] += 3;
    if (t[1] != 5) {
        return 1;
    }
    var q: <i32, i32> = .{7, 8};
    if (q[0] != 7 || q[1] != 8) {
        return 1;
    }
    q = .{3, 4};
    if (q[0] != 3 || q[1] != 4) {
        return 1;
    }
    var h: <i32, i64> = .<i32, i64>{1, 2000000000};
    if (h[0] != 1 || h[1] != 2000000000) {
        return 1;
    }
    var n: <<i32, i32>, i32> = .<<i32, i32>, i32>{.<i32, i32>{3, 4}, 9};
    if (n[0][0] != 3 || n[0][1] != 4 || n[1] != 9) {
        return 1;
    }
    if (sum(.<i32, i32>{1, 2}) != 3) {
        return 1;
    }
    var a: <i32, i32> = t;
    if (a[0] != 5 || a[1] != 5) {
        return 1;
    }
    var b: <i32, i32> = .{5, 5};
    if (a != b) {
        return 1;
    }

    printf("tuple ok\n");
    return 0;
}

func sum(p: <i32, i32>): i32 {
    return p[0] + p[1];
}
