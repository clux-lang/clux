// functions.cx — M1 样例：函数定义（参数+返回类型）、前向引用、递归、调用、bool 字面量
extern lib "*" as libc;
extern cfunc libc::printf(format: str, ...): void;
func add(a: i32, b: i32): i32 {
    return a + b;
}

func main(): i32 {
    var s: i32 = add(1, 2); // 带实参的函数调用
    var flag: bool = true; // bool 字面量

    if (flag) {
        // 条件分支
        s = add(s, 10);
    }

    libc::printf("s = %d\n", s);
    return 0;
}

// 定义在 main 之后，但可被 main 调用（无前置声明：Pass 1 收集顶层名称）
func fib(n: i32): i32 {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2); // 递归 / 前向调用
}
