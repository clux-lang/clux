// array.cx — 样例：数组类型 [N]T、构造、下标读写、多维、函数传参
//
//   - 构造：.[N]T { v1, ..., vN }，成员按序求值，数量与 N 一致
//   - 下标读取：a[i] 右值（INDEX_GET），i 可为表达式
//   - 下标写入：a[i] = v / a[i] op= v（INDEX_SET 借用引用直写原数组）
//   - 多维数组：[2][2]i32 是嵌套数组，a[i][j] 逐维下降
//   - 函数参数/返回：数组按值传递（参数是拷贝），形参类型 [N]T
//   - 借用引用绑定：var row = a[i] 绑定的是借用引用，赋值给变量时
//     深拷贝为独立副本（materialize），修改 row 不影响 a
//   - 越界检查：INDEX_GET/SET 运行时越界返回 error

// 数组作为函数参数（按值拷贝，函数内修改不影响实参）
func sum_arr(a: [3]i32): i32 {
    return a[0] + a[1] + a[2];
}

// 数组作为返回值：构造新的数组返回
func double_arr(a: [3]i32): [3]i32 {
    return .[3]i32 { a[0] * 2, a[1] * 2, a[2] * 2 };
}

func main(): i32 {
    // ---- 一维数组构造与下标读写 ----
    var a = .[3]i32 { 10, 20, 30 };
    var x = a[0] + a[2];   // 下标右值读取：10 + 30
    a[1] = 99;             // 下标左值写入
    a[2] += 1;             // 下标复合赋值：30 → 31
    printf("x = %d, a = %d %d %d\n", x, a[0], a[1], a[2]);

    // 变量下标：i 可为任意表达式
    var i = 1;
    var z = a[i] * 2;
    a[i] = z;
    printf("z = %d, a[1] = %d\n", z, a[1]);

    // ---- 多维数组：嵌套数组逐维下标 ----
    var m = .[2][2]i32 { .[2]i32 { 1, 2 }, .[2]i32 { 3, 4 } };
    var y = m[1][0];       // 3
    m[1][0] = 7;           // 深层写入直达原数组
    var j = 1;
    m[0][j] += 10;         // 变量下标 + 复合赋值
    printf("y = %d, m = %d %d / %d %d\n",
           y, m[0][0], m[0][1], m[1][0], m[1][1]);

    // ---- 函数传参（按值拷贝）与返回值 ----
    var s = sum_arr(a);
    var d = double_arr(a);
    printf("sum = %d, doubled = %d %d %d\n", s, d[0], d[1], d[2]);

    // ---- 借用引用绑定变量：深拷贝为独立副本 ----
    var row = m[1];        // 绑定 m[1] 的借用引用 → 变量深拷贝
    row[0] = 100;          // 修改 row 不影响 m
    printf("row = %d %d, m[1] = %d %d\n", row[0], row[1], m[1][0], m[1][1]);

    // 越界下标：运行时报错（反注释验证）
    // var bad = a[5];

    return 0;
}
