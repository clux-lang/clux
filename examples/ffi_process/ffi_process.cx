// ffi_process.cx — M6 FFI：`extern lib "*" as <别名>;` = **当前进程自身**
//
// libc 这类库在进程启动时就已经链接进来了，不需要（也不该）再 `dlopen` 一次。
// 把**路径写成 "*"** 就声明了一个"当前进程"伪库：没有任何文件被加载，符号解析
// 走 RTLD_DEFAULT 的等价实现
//   - POSIX：`dlsym(RTLD_DEFAULT, name)`（可执行文件 + 依赖 + RTLD_GLOBAL 的库）
//   - Windows：先主模块、再遍历已加载模块（CRT 的 abs/strlen 都在这里）
// 别名照常起，函数/数据符号照常用 `<别名>::<名>` 引用——与显式加载某个文件
// （`extern lib "msvcrt.dll" as crt;`）走**完全同一条**编译与运行通路。
//
// `extern func c::abs(...)` 与 `extern cfunc c::abs(...)` 等价（限定名已经表明它
// 来自外部库）；`cfunc` 是规范写法（显式标注 C ABI），`clux format` 会统一渲染成它。

extern lib "*" as c;

extern func  c::abs(x: i32): i32;    // 与 extern cfunc 等价
extern cfunc c::strlen(s: str): u64;
extern var   c::_osplatform: u32;    // 进程里的数据符号同样可读

func main(): i32 {
    // 函数：整数与**无符号返回值**都按声明类型落地（u64 就是 u64）
    if (c::abs(-7) != 7) { return 1; }
    if (c::strlen("hello") != 5u64) { return 2; }

    var s: str = "abcd";
    var n: u64 = c::strlen(s);
    if (n != 4u64) { return 3; }

    // 数据符号：读到的是进程里那块内存（现代 Windows 上 _osplatform = 2）
    if (c::_osplatform == 0u32) { return 4; }

    printf("c::abs(-7) = %d, c::strlen(\"%s\") = %u, _osplatform = %u\n",
           c::abs(-7), s, n, c::_osplatform);
    return 0;
}
