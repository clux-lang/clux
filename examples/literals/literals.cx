// literals.cx — M1 样例：整数字面量（多进制+后缀）、浮点、布尔、字符、字符串
func main(): i32 {
    // 整数：十进制 / 十六进制 / 八进制 / 二进制
    var dec: i32 = 42;
    var hex: i32 = 0xFF;
    var oct: i32 = 0o17;
    var bin: i32 = 0b1010;

    // 整数：显式类型后缀
    var v8: i8 = 7i8;
    var v16: i16 = 7i16;
    var v32: i32 = 7i32;
    var v64: i64 = 7i64;
    var vU8: u8 = 7u8;
    var vU16: u16 = 7u16;
    var vU32: u32 = 7u32;
    var vU64: u64 = 7u64;

    // 浮点字面量
    var pi: f64 = 3.14159;
    var exp: f64 = 1.0e10;
    var frac: f32 = 2.5f32;

    // 布尔字面量
    var yes: bool = true;
    var no: bool = false;

    // 字符字面量（值类型 u8）
    var ch: u8 = 'A';

    // 字符串字面量（类型 str）
    var text: str = "clux language\n";

    // 逻辑运算符与显式丢弃（M1 无隐式提升：混合运算须手工 as 到公共类型）
    _ = dec + hex + oct + bin + (v8 as i32) + (vU8 as i32);
    _ = (pi as f64) + (exp as f64) + (frac as f64);
    _ = yes && no || yes;

    printf(text);

    var arr =.[1] i32 {
        123
    };
    printf("arr = %v", arr);
    return 0;
}
