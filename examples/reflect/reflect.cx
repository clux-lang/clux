// reflect.cx — 编译期反射：`T.<key>`（类型值成员注入）
//
// 元数据在 sema 阶段折叠成常量（与 sizeof/typeof 同族），运行期零开销、零存储。
// 设计见 docs/reflect-builtin-design.md。
//
//   T.name / T.size / T.align / T.kind        通用（kind 是编译期字符串）
//   T.field_count / T.field_name(i) / ...     struct / union / cunion / tuple / enum / func
//   T.method_count / T.method_type("run")     struct 成员（方法）
//   T.attribute_count / T.attribute_type(i)   struct 成员（静态属性）
//   T.<key> 可链式：T.field_type(0).name
//   类型值不能存变量 → 绑定反射出的类型用 `type Alias = T.field_type(0);`
//
// 所有权不在反射里：运行时所有权由标准库类型/分配器负责，反射只描述类型形状。

extern lib libc from "*";
extern cfunc libc::printf(format: str, ...): i32;

struct Point {
    x: i32;
    y: i64;
};

enum Color: i32 { Red = 1, Green = 2 }

struct Runner {
    var speed: i32 = 0;
    var tag: i64 = 0;

    func run(self: *Runner, a: i32): i64 { return 1i64; }
    func stop(self: *Runner): void { }
}

type A3 = [3]i32;
type Cb = func(i32) -> i64;

func main(): i32 {
    // ① 通用
    _ = libc::printf("i32: %s size=%d align=%d kind=%s\n", i32.name,
                 i32.size as i32, i32.align as i32, i32.kind);

    // ② struct 字段
    _ = libc::printf("Point: kind=%s fields=%d\n", Point.kind,
                 Point.field_count as i32);
    _ = libc::printf("  field0 = %s off=%d type=%s\n", Point.field_name(0),
                 Point.field_offset(0) as i32, Point.field_type(0).name);
    _ = libc::printf("  field1 = %s off=%d type=%s\n", Point.field_name(1),
                 Point.field_offset(1) as i32, Point.field_type(1).name);

    // ③ enum
    _ = libc::printf("Color: variants=%d [%s=%d, %s=%d] underlying=%s\n",
                 Color.variant_count as i32, Color.variant_name(0),
                 Color.variant_value(0) as i32, Color.variant_name(1),
                 Color.variant_value(1) as i32, Color.underlying.name);

    // ④ 成员：方法签名（按名）+ 静态属性
    _ = libc::printf("Runner: methods=%d attrs=%d\n",
                 Runner.method_count as i32, Runner.attribute_count as i32);
    _ = libc::printf("  method0 = %s\n", Runner.method_name(0));
    _ = libc::printf("  run: params=%d p0=%s ret=%s variadic=%d\n",
                 Runner.method_type("run").param_count as i32,
                 Runner.method_type("run").param_type(0).name,
                 Runner.method_type("run").return_type.name,
                 Runner.method_type("run").is_variadic as i32);
    _ = libc::printf("  attr0 = %s type=%s\n", Runner.attribute_name(0),
                 Runner.attribute_type(0).name);

    // ⑤ 数组 / func
    _ = libc::printf("A3: kind=%s length=%d elem=%s\n", A3.kind, A3.length as i32,
                 A3.elem_type.name);
    _ = libc::printf("Cb: kind=%s params=%d p0=%s ret=%s c_abi=%d\n", Cb.kind,
                 Cb.param_count as i32, Cb.param_type(0).name,
                 Cb.return_type.name, Cb.is_c_abi as i32);

    // ⑥ 链式 + typeof 入口
    struct H { t: <i32, f64>; }
    _ = libc::printf("H.t: e0=%s e1=%s\n", H.field_type(0).elem_type(0).name,
                 H.field_type(0).elem_type(1).name);
    var v: i64 = 3;
    _ = libc::printf("typeof(v): name=%s size=%d\n", typeof(v).name,
                 typeof(v).size as i32);

    // ⑦ 绑定反射出的类型
    type F0 = H.field_type(0);
    _ = libc::printf("F0: elems=%d\n", F0.elem_count as i32);
    return 0;
}
