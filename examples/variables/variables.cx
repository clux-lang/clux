// variables.cx — M1 样例：变量声明（显式标注/推断）、赋值、显式丢弃
extern lib libc from "*";
extern cfunc libc::printf(format: str, ...): void;
func main(): i32 {
    var x: i32 = 10; // 显式类型标注
    var y = 20; // 类型推断
    var z: i32 = 30;

    x = x + y; // 普通赋值（仅语句，不可链式）
    _ = z; // 显式丢弃表达式返回值

    libc::printf("x = %d, z = %d\n", x, z);
    return 0;
}
