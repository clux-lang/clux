// local_typehoist.cx — 样例：局部 type 定义自动提升（hoist）
//
// 函数体/块内的 type def 与顶层 type def 一样会被编译器**提升**（hoist）：
//
//   - 前向引用合法：局部 type 定义在块内后置（使用在定义之前）仍可见，
//     var 槽位的显式类型标注延迟解析，块入口提升绑定后兜底成功
//   - 提升遮蔽：局部 type 与全局同名 type 时，**整个块内**都解析为局部定义
//     （遮蔽从块入口生效，与定义位置无关）
//   - 嵌套块各自提升：内层块只提升本块的 type def，出块即不可见
//   - 运行期：块入口先 DEFINE 类型名再执行语句，循环体内每次迭代幂等提升
//
// 注：sema 阶段类型表达式仍按依赖序编译期求值（CTFE 无前向引用），
// 别名链须按依赖序声明；提升只作用于"类型构造"这一运行期阶段。

type Local = i32; // 全局同名 type：用于演示局部遮蔽

func main(): i32 {
    // ---- 前向引用 + 提升遮蔽：定义在后使用在前 ----
    var x: Local = 7; // 块内 Local 一律是局部 i64（提升遮蔽，非全局 i32）
    type Local = i64; // 局部 type def：遮蔽全局同名 type，块内全范围生效

    {
        // ---- 嵌套块：内层只提升本块的 type def ----
        var y: Inner = 9;
        type Inner = i32;
        x = x + (y as i64);
    }
    // var z: Inner = 1; // 出块不可见（反注释可验证编译错误）

    printf("x = %d\n", x as i32);
    return 0;
}
