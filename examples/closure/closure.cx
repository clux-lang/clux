// closure.cx — 样例：闭包（捕获列表）
//
// 闭包语法：func |a,(b:i32 = c+d)| name(params): ret { body }
//   捕获列表紧跟 func 之后，以 '|' 分隔，逗号分隔各项：
//     - 纯 id 捕获：a —— 捕获外层变量 a（clone 值，非引用）
//     - 括号 VALUE DECL：(b: i32 = c+d) —— 临时构造捕获值，定义点
//       在外层作用域求值后存入闭包（type 可选、init 必选）
//   空列表 || 合法（等价无捕获函数）。
//
// 语义要点：
//   - 捕获列表进入类型身份：`func |base: i32| (i32) -> i32` 与无捕获的
//     `func(i32) -> i32` 是**不同类型**（不擦除；需要可调用对象时用泛型）
//   - 捕获是 clone 值而非引用：闭包创建后修改外层变量不影响闭包
//   - 函数提升：捕获在定义点绑定（LOAD_FUNCTION + SET_CLOSURE）；
//     提升后、定义点前调用 → 捕获槽是 undefined → 运行期 TDZ 报错
//   - 把带捕获闭包赋给 `func(...)`（无捕获签名）会被拒绝
//   - 全局函数 / comptime 函数不能带捕获列表
//
// 与无捕获函数的差异：无捕获函数 body 内访问外层局部变量编译期拒绝
// （未在捕获列表中声明的变量不属于闭包）。

extern lib libc from "*";
extern cfunc libc::printf(format: str, ...): i32;
func make_adder(): func |base: i32| (i32) -> i32 {
    var base = 10;
    // 捕获外层局部变量 base（clone 10）
    return func |base| add(x: i32): i32 {
        return base + x;
    };
}

func main(): i32 {
    // ---- 工厂：返回捕获外层变量的闭包 ----
    var f = make_adder();
    _ = libc::printf("f(5) = %d\n", f(5)); // 15

    // ---- clone 语义：外层修改不影响闭包 ----
    var base = 10;
    var g = func |base| add2(x: i32): i32 {
        return base + x;
    };
    base = 1000;
    _ = libc::printf("clone = %d\n", g(5)); // 15（捕获时 clone 的 10）

    // ---- 括号捕获：临时构造捕获值 ----
    var a = 5;
    var c = 100;
    var d = 7;
    var h = func |a, (b: i32 = c + d)| add3(x: i32): i32 {
        return a + b + x;
    };
    _ = libc::printf("paren = %d\n", h(1)); // 5 + 107 + 1 = 113

    // ---- 语句级局部函数带捕获（提升 + 定义点绑定）----
    var x = 42;
    func |x| local(v: i32): i32 {
        return x + v;
    }
    _ = libc::printf("local = %d\n", local(1)); // 43

    // ---- 循环内重建闭包：每次迭代捕获当前 i 的 clone ----
    var total = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var iter = func |i| mul(n: i32): i32 {
            return i * n;
        };
        total = total + iter(10);
    }
    _ = libc::printf("loop = %d\n", total); // 0 + 10 + 20 = 30

    return 0;
}
