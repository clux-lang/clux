// local_function.cx — 样例：局部函数定义语句
//
// 局部函数 = 符号只在定义作用域可见的全局函数：
//
//   - 定义位置：函数体/块内任意位置（func name(params): ret { body }）
//   - 提升（hoist）：定义在后、调用在前合法——块入口先注册函数名，
//     整个块内可见（与局部 type 提升同机制）
//   - 可访问：自己的参数 + 全局函数 + 全局变量（无捕获，闭包未来支持）
//   - 不可访问：外层局部变量 / 兄弟局部函数 / 自身（递归）——这些是
//     闭包语义，当前编译期拒绝（反注释可验证编译错误）
//   - comptime 局部函数：调用点编译期折叠，零运行时指令

func global_add(a: i32, b: i32): i32 {
    return a + b;
}

func main(): i32 {
    // ---- 前向调用：定义在后、调用在前（提升注册）----
    var r = caller(5);
    func caller(x: i32): i32 { return x + 1; }   // caller(5) → 6

    // ---- 访问参数 + 全局变量 ----
    var base: i32 = 100;
    func scale(v: i32, f: i32): i32 { return v * f; }  // 只用参数
    var s = scale(3, 4);

    // ---- 调用全局函数 ----
    func wrapped(a: i32, b: i32): i32 { return global_add(a, b) + 1; }
    var w = wrapped(10, 20);

    // ---- comptime 局部函数：编译期折叠 ----
    comptime func twice(x: i32): i32 { return x * 2; }
    var t = twice(5);

    printf("caller=%d scale=%d wrapped=%d twice=%d\n", r, s, w, t);

    // ---- 捕获外层局部变量：闭包语义，编译期拒绝（反注释验证）----
    // func bad(x: i32): i32 { return x + base; }
    // var b = bad(1);

    // ---- 递归 / 兄弟调用：同样需要闭包，当前拒绝（反注释验证）----
    // func self_ref(n: i32): i32 { return self_ref(n - 1); }
    // func sib(x: i32): i32 { return caller(x); }

    return 0;
}
