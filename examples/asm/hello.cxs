; hello.cxs — 最小可运行示例：打印一行字符串
; 引导段 _start 注册 main，再由虚拟机调用 main
_start:
    push_func_type
    push "void"
    func_type_return
    seal
    push_function [main]
    bind_func 64
    set_func_name "main"
    push_undefined
    define "main"
    halt
main:
    push_scope
    push "printf"
    push_string "hello, clux\n"
    call 1
    pop
    pop_scope
    push_undefined
    ret
