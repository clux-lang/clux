; factorial.cxs — 递归求阶乘（fact(10) = 3628800）
_start:
    push_func_type
    push "i32"
    func_type_param
    push "i32"
    func_type_return
    seal
    push_function [fact] 64
    bind_func 64
    set_func_name "fact"
    push_undefined
    define "fact"
    push_func_type
    push "void"
    func_type_return
    seal
    push_function [main] 65
    bind_func 65
    set_func_name "main"
    push_undefined
    define "main"
    halt
fact:
    push_undefined
    define "n"
    push_scope
    push "n"
    push_i32 1
    le
    jz [rec]
        push_scope
        push_i32 1
        ret
        pop_scope
; rec：返回 n * fact(n-1)
rec:
    push "n"
    push "fact"
    push "n"
    push_i32 1
    sub
    call 1
    mul
    ret
    pop_scope
    push_undefined
    ret
main:
    push_scope
    push "printf"
    push_string "fact(10) = %d\n"
    push "fact"
    push_i32 10
    call 1
    call 2
    pop
    pop_scope
    push_undefined
    ret
