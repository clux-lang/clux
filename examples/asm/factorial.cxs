; factorial.cxs - 递归求阶乘（fact(10) = 3628800）
; 类型提升区（hoist 两遍扫描）：pass 1 声明全部签名（fact id 64 / main id 65），
; pass 2 定义 + SEAL 封闭（依赖后序）；引导段 LOAD_TYPE 拉回签名注册函数
_start:
    ; pass 1 声明所有类型
    push_func_type
    define_type 64
    push_func_type
    define_type 65
    ; pass 2 定义所有类型（依赖后序）
    load_type 64
    push "i32"
    func_type_param
    push "i32"
    func_type_return
    seal
    load_type 65
    push "void"
    func_type_return
    seal
    ; 函数注册段
    load_type 64
    push_function [fact]
    bind_func 64
    set_func_name "fact"
    push_undefined
    define "fact"
    load_type 65
    push_function [main]
    bind_func 65
    set_func_name "main"
    push_undefined
    define "main"
    halt
fact:
    push_undefined
    define "n"
    push_scope
    push "n"
    push_i32 1
    le
    jz [rec]
        push_scope
        push_i32 1
        ret
        pop_scope
; rec：返回 n * fact(n-1)
rec:
    push "n"
    push "fact"
    push "n"
    push_i32 1
    sub
    call 1
    mul
    ret
    pop_scope
    push_undefined
    ret
main:
    push_scope
    push "printf"
    push_string "fact(10) = %d\n"
    push "fact"
    push_i32 10
    call 1
    call 2
    pop
    pop_scope
    push_undefined
    ret
