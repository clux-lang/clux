; loop.cxs - while 风格循环：累加 1..10
; 类型提升区（hoist 两遍扫描）：pass 1 声明 main 签名，pass 2 定义 + SEAL 封闭
_start:
    ; pass 1 声明所有类型
    push_func_type
    define_type 64
    ; pass 2 定义所有类型（依赖后序）
    load_type 64
    push "void"
    func_type_return
    seal
    ; 函数注册段：LOAD_TYPE 拉回密封签名 → PUSH_FUNCTION
    load_type 64
    push_function [main]
    bind_func 64
    set_func_name "main"
    push_undefined
    define "main"
    halt
main:
    push_scope
    push_i32 0
    push_undefined
    define "sum"
    push_i32 1
    push_undefined
    define "i"
loop:
    ; 循环条件：i <= 10 ? 否则跳出到 end
    push "i"
    push_i32 10
    le
    jz [end]
        push "sum"
        push "i"
        add
        store "sum"
        push "i"
        push_i32 1
        add
        store "i"
        jmp [loop]
end:
    push "printf"
    push_string "sum(1..10) = %d\n"
    push "sum"
    call 2
    pop
    push_undefined
    ret
