; arithmetic.cxs — 带参数的函数 add(a, b) 与嵌套调用
; 引导段先注册 add，再注册 main
_start:
    push_func_type
    push "i32"
    func_type_param
    push "i32"
    func_type_param
    push "i32"
    func_type_return
    seal
    push_function [add]
    bind_func 64
    set_func_name "add"
    push_undefined
    define "add"
    push_func_type
    push "void"
    func_type_return
    seal
    push_function [main]
    bind_func 65
    set_func_name "main"
    push_undefined
    define "main"
    halt
; add：返回 a + b（形参由 PUSH_UNDEFINED/DEFINE 声明）
add:
    push_undefined
    define "b"
    push_undefined
    define "a"
    push_scope
    push "a"
    push "b"
    add
    ret
    pop_scope
    push_undefined
    ret
main:
    push_scope
    push "printf"
    push_string "the answer is %d\n"
    push "add"
    push_i32 40
    push_i32 2
    call 2
    call 2
    pop
    pop_scope
    push_undefined
    ret
