// const_volatile.cx — 样例：const/volatile 限定类型
//
//   const     — 声明后不可再赋值；TDZ 首次赋值（= 初始化）豁免
//   volatile  — 存取语义提示（禁止优化器重排/合并读写），读写全合法
//   const volatile T — 组合限定（固定顺序 volatile(const(T))）
extern lib "*" as libc;
extern cfunc libc::printf(format: str, ...): void;
func main(): i32 {
    // const：TDZ 首次赋值豁免（var x:const T = undefined 后的首次赋值即初始化）
    var a: const i32 = undefined;
    a = 123; // 首次赋值 = 初始化，合法
    // a = 456;             // 再赋值非法（const）——反注释可验证编译错误

    // volatile：读写/运算/赋值全合法（代理子类型功能）
    var b: volatile i32 = 1;
    b = b + 1;

    // 组合：const volatile i32（volatile 外层包裹 const）
    var c: const volatile i32 = undefined;
    c = 7; // 首次赋值豁免
    // c = 8;               // 再赋值非法

    // const 值可复制到非 const 变量（const T extends T 复制语义）
    var d: i32 = a;

    libc::printf("a=%d b=%d c=%d d=%d\n", a, b, c, d);
    return 0;
}
