// spread_args.cx — 实参展开 `...expr`（函数调用 + 构造）
//
// 一、函数调用的实参位置：把**编译期长度已知**的数组/元组摊开成多个实参
//     （sema 阶段展开成 `expr[0], expr[1], …`）：
//
//       fn(a, ...b, c)   ⇒   fn(a, b[0], b[1], …, c)
//
// 二、构造器（`.T{...}` 值构造 + 展开）：
//     - **struct 目标**：按字段 kv 展开
//         `.Point{ ...p }`  ⇒  `.Point{ .x = p.x, .y = p.y }`
//       展开 + 显式字段可混用；同名字段**后写的覆盖先写的**
//       （`.Point{ ...p, .x = 10 }`）。异构 struct 按**字段名**兼容。
//     - **数组/元组目标**：按位置展开
//         `.[2]i32{ ...arr }`  ⇒  `.[2]i32{ arr[0], arr[1] }`
//
// 规则：
//   - 只接受编译期长度已知的形状：`[N]T`、`<T1,T2,…>`、struct；切片 `[]T`
//     会报 "must be a struct, array or tuple with a compile-time-known shape"。
//   - 操作数必须是**可复读的位置表达式**（变量 / 成员访问）：展开后每个字段/
//     元素都是一次 `operand.f` / `operand[i]` 读取，带副作用的表达式会被重复
//     求值，因此要求先落到临时变量。
//   - 空数组展开出 0 个实参/字段。

extern lib libc from "*";
extern cfunc libc::printf(format: str, ...): i32;

struct Point {
    x: i32;
    y: i32;
}

struct Pair {
    x: i32;
    y: i32;
}

struct Box {
    pair: [2]i32;
}

func sum2(a: i32, b: i32): i32 { return a + b; }
func sum3(a: i32, b: i32, c: i32): i32 { return a + b + c; }
func sum4(a: i32, b: i32, c: i32, d: i32): i32 { return a + b + c + d; }

func main(): i32 {
    // ---- 一、函数调用 ----
    // ① 数组展开（中间位置）：sum4(1, 2, 3, 4) = 10
    var arr = .[2]i32{ 2, 3 };
    _ = libc::printf("sum4(1, ...arr, 4) = %d\n", sum4(1, ...arr, 4));

    // ② 元组展开（前置）：sum3(10, 20, 5) = 35
    var tup = .<i32, i32>{ 10, 20 };
    _ = libc::printf("sum3(...tup, 5) = %d\n", sum3(...tup, 5));

    // ③ 成员访问作操作数：sum2(7, 8) = 15
    var box = .Box{ .pair = .[2]i32{ 7, 8 } };
    _ = libc::printf("sum2(...box.pair) = %d\n", sum2(...box.pair));

    // ④ 空数组：0 个实参 → sum2(1, 2) = 3
    var empty = .[0]i32{};
    _ = libc::printf("sum2(1, 2, ...empty) = %d\n", sum2(1, 2, ...empty));

    // ⑤ 与 C 变参混用：printf("%d+%d\n", 3, 4)
    var nums = .[2]i32{ 3, 4 };
    _ = libc::printf("printf: %d+%d\n", ...nums);

    // ---- 二、构造器 ----
    var p = .Point{ .x = 3, .y = 4 };

    // ⑥ struct 按字段 kv 展开
    var q = .Point{ ...p };
    _ = libc::printf("q = (%d, %d)\n", q.x, q.y);

    // ⑦ 值构造 + 展开
    var r = .Point{ ...p };
    _ = libc::printf("r = (%d, %d)\n", r.x, r.y);

    // ⑧ 异构 struct 按字段名兼容
    var pr = .Pair{ ...p };
    _ = libc::printf("pr = (%d, %d)\n", pr.x, pr.y);

    // ⑨ 展开 + 显式字段：同名字段后写的覆盖先写的 → (10, 4)
    var s = .Point{ ...p, .x = 10 };
    _ = libc::printf("s = (%d, %d)\n", s.x, s.y);

    // ⑩ 数组/元组构造按位置展开
    var arr2 = .[2]i32{ ...arr };
    var tup2 = .<i32, i32>{ ...tup };
    _ = libc::printf("arr2 = (%d, %d), tup2 = (%d, %d)\n", arr2[0], arr2[1],
                 tup2[0], tup2[1]);

    if (sum4(1, ...arr, 4) != 10) { return 1; }
    if (sum3(...tup, 5) != 35) { return 2; }
    if (sum2(...box.pair) != 15) { return 3; }
    if (sum2(1, 2, ...empty) != 3) { return 4; }
    if (q.x != 3 || q.y != 4) { return 5; }
    if (r.x != 3 || r.y != 4) { return 6; }
    if (pr.x != 3 || pr.y != 4) { return 7; }
    if (s.x != 10 || s.y != 4) { return 8; }
    if (arr2[0] != 2 || arr2[1] != 3) { return 9; }
    if (tup2[0] != 10 || tup2[1] != 20) { return 10; }
    return 0;
}
