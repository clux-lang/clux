// arithmetic.cx — M1 样例：算术/位运算、一元运算、复合赋值、类型转换 as
extern lib "*" as libc;
extern cfunc libc::printf(format: str, ...): void;
func main(): i32 {
    var a: i32 = 40;
    var b: f64 = 2.0;

    // 二元运算符
    var sum: i32 = a + 8; // 加法
    var neg: i32 = -sum; // 一元负号
    var prod: i32 = a * 2; // 乘法
    var quot: i32 = a / 2; // 除法
    var rem: i32 = a % 3; // 取模

    // 位运算符
    var shl: i32 = a << 2; // 左移
    var shr: i32 = a >> 1; // 右移
    var band: i32 = a & 1; // 按位与
    var bor: i32 = a | 4; // 按位或
    var bxor: i32 = a ^ 7; // 按位异或
    var bnot: i32 = ~a; // 按位取反

    // 复合赋值
    a += 1;
    a -= 1;
    a *= 2;
    a /= 2;
    a %= 3;

    // 类型转换：<expr> as <type>
    var r: f64 = a as f64 + b;
    var s: i32 = (sum + 1) as i32;

    libc::printf("sum = %d, prod = %d, bnot = %d, r = %f\n", sum, prod, bnot, r);
    return 0;
}
